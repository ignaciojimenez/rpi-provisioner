# Copy to hosts.secrets.yml and fill in. That file is gitignored.
#
# Split from hosts.yml so the presets can be committed: everything here would
# be published if it lived in the tracked file. Any key set here overrides the
# same key in hosts.yml's defaults: block.

defaults:
  password: "the default user password"
  wifi_ssid: "YourNetwork"
  wifi_pass: "the WPA passphrase"
